# HSC Global Services Environment Configuration Example

# Google Apps Script Web App Deployment URL
# Deployed from google-apps-script/Code.gs
# Example: https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Shared Secret Token for Google Apps Script Web App Authentication
# Set the matching value in Google Apps Script under Project Settings -> Script Properties (Key: SHARED_SECRET)
GOOGLE_APPS_SCRIPT_SECRET=your-secure-random-shared-secret-token

# Recruitment Destination Email (fixed to hscglobalenterprises5@gmail.com)
RECRUITMENT_EMAIL=hscglobalenterprises5@gmail.com

# Server port (default 3000)
PORT=3000
